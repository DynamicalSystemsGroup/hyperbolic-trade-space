@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam ClassBackgroundColor white
skinparam ClassBorderColor #404040
skinparam ArrowColor #404040
skinparam RectangleBackgroundColor white
skinparam nodesep 12
skinparam ranksep 30
hide circle
hide empty members

class "Cubesat\n<<part def>>" as Cubesat #E8EEF7 {
  .. design variables ..
  panelSpan : LengthValue
  batteryCapacity : EnergyValue
}
class "Bus\n<<part def>>" as Bus {
}
Cubesat *-- "bus" Bus
class "SolarPanel\n<<part def>>" as SolarPanel {
  span : LengthValue   (variable)
}
Cubesat *-- "panelPlus" SolarPanel
Cubesat *-- "panelMinus" SolarPanel
class "Battery\n<<part def>>" as Battery {
  capacity : EnergyValue   (variable)
}
Cubesat *-- "battery" Battery
class "Antenna\n<<part def>>" as Antenna {
}
Cubesat *-- "antenna" Antenna
class "Imu\n<<part def>>" as Imu {
}
Cubesat *-- "imu" Imu
class "ReactionWheel\n<<abstract part def>>" as ReactionWheel {
}
Cubesat *-- "wheel" ReactionWheel
class "LargeWheel\n<<part def>>" as LargeWheel {
}
ReactionWheel <|-- LargeWheel
class "MediumWheel\n<<part def>>" as MediumWheel {
}
ReactionWheel <|-- MediumWheel
class "SmallWheel\n<<part def>>" as SmallWheel {
}
ReactionWheel <|-- SmallWheel
note bottom of ReactionWheel : choice (design variable) WheelClass: small | medium | large
class "StarTracker\n<<abstract part def>>" as StarTracker {
}
Cubesat *-- "tracker" StarTracker
class "CoarseTracker\n<<part def>>" as CoarseTracker {
}
StarTracker <|-- CoarseTracker
class "FineTracker\n<<part def>>" as FineTracker {
}
StarTracker <|-- FineTracker
class "MediumTracker\n<<part def>>" as MediumTracker {
}
StarTracker <|-- MediumTracker
note bottom of StarTracker : choice (design variable) TrackerGrade: coarse | medium | fine
class "Controller\n<<part def>>" as Controller {
  Kp : Real   (variable)
  Kd : Real   (variable)
}
Cubesat *-- "controller" Controller
note right of Cubesat
  **ranges (read from the model)**
  panelSpan: 0.3 m .. 1 m
  batteryCapacity: 20 W*h .. 200 W*h
  baselineGains: Kp 0.03 .. 1, Kd 0.3 .. 1.5
  aggressiveGains: Kp 0.2 .. 2, Kd 0.3 .. 1.5
end note
@enduml
