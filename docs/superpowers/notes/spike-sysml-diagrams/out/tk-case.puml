@startuml
usecase "ConfigurationVerification" as n1 <<verification case def>>
rectangle "c : Cubesat" as n2 <<subject>>
usecase "SlewVerification" as n3 <<verification case def>>
rectangle "c : Cubesat" as n4 <<subject>>
usecase "SlewExperiment" as n5 <<analysis case def>>
rectangle "cubesat : Cubesat" as n6 <<subject>>
n1 -- n2 : «subject»
note "«objective»" as o1
o1 .. n1
n3 -- n4 : «subject»
note "«objective»" as o2
o2 .. n3
n5 -- n6 : «subject»
note "Before simulation: what the configuration alone decides. " as c1
c1 .. n1
note "After the slew is measured: what needs the measured quantities. " as c2
c2 .. n3
@enduml
