@startuml
' interconnection rendering (no view declared; rendering CubesatTradeSpaceV2::Cubesat directly)
<style>
root {
  BackGroundColor white
  FontName SansSerif
  FontSize 14
  FontColor black
  LineColor #181818
  HorizontalAlignment left
}
element {
  BackGroundColor white
  LineColor #181818
  LineThickness 0.5
  RoundCorner 0
  Shadowing 0.0
}
start, end, activityBar {
  BackGroundColor black
}
arrow {
  LineColor #181818
  LineThickness 1
  FontSize 13
}
note {
  BackGroundColor #FEFFDD
  FontSize 13
}
.usage {
  RoundCorner 20
}
.package {
  LineThickness 1.5
}
.region {
  LineStyle 4
}
</style>
skinparam wrapWidth 300
hide stereotype
rectangle "**Cubesat**\n<size:10>//«part def»//</size>" as n0 <<part def>> {
  rectangle "**panelSpan : LengthValue**\n<size:10>//«attribute»//</size>" as n1 <<attribute>> <<usage>>
  rectangle "**batteryCapacity : EnergyValue**\n<size:10>//«attribute»//</size>" as n2 <<attribute>> <<usage>>
  rectangle "**bus : Bus**\n<size:10>//«part»//</size>" as n3 <<part>> <<usage>>
  rectangle "**panelPlus : SolarPanel**\n<size:10>//«part»//</size>" as n4 <<part>> <<usage>> {
    rectangle "**span**\n<size:10>//«attribute»//</size>" as n5 <<attribute>> <<usage>>
  }
  rectangle "**panelMinus : SolarPanel**\n<size:10>//«part»//</size>" as n6 <<part>> <<usage>> {
    rectangle "**span**\n<size:10>//«attribute»//</size>" as n7 <<attribute>> <<usage>>
  }
  rectangle "**battery : Battery**\n<size:10>//«part»//</size>" as n8 <<part>> <<usage>> {
    rectangle "**capacity**\n<size:10>//«attribute»//</size>" as n9 <<attribute>> <<usage>>
  }
  rectangle "**antenna : Antenna**\n<size:10>//«part»//</size>" as n10 <<part>> <<usage>>
  rectangle "**imu : Imu**\n<size:10>//«part»//</size>" as n11 <<part>> <<usage>>
  rectangle "**wheel : ReactionWheel**\n<size:10>//«part»//</size>" as n12 <<part>> <<usage>>
  rectangle "**tracker : StarTracker**\n<size:10>//«part»//</size>" as n13 <<part>> <<usage>>
  rectangle "**controller : Controller**\n<size:10>//«part»//</size>" as n14 <<part>> <<usage>>
  rectangle "**wheelCount : Integer**\n<size:10>//«attribute»//</size>" as n15 <<attribute>> <<usage>>
  rectangle "**totalMass : MassValue**\n<size:10>//«attribute»//</size>" as n16 <<attribute>> <<usage>>
  rectangle "**structureMass : MassValue**\n<size:10>//«attribute»//</size>" as n17 <<attribute>> <<usage>>
  rectangle "**adcsMass : MassValue**\n<size:10>//«attribute»//</size>" as n18 <<attribute>> <<usage>>
  rectangle "**momentumCapacity : AngularMomentumValue**\n<size:10>//«attribute»//</size>" as n19 <<attribute>> <<usage>>
  rectangle "**generatedPower : PowerValue**\n<size:10>//«attribute»//</size>" as n20 <<attribute>> <<usage>>
  rectangle "**availablePower : PowerValue**\n<size:10>//«attribute»//</size>" as n21 <<attribute>> <<usage>>
  rectangle "**usableWheelTorque : TorqueValue**\n<size:10>//«attribute»//</size>" as n22 <<attribute>> <<usage>>
}
@enduml
