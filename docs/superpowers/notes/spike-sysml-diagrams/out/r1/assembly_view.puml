@startuml
top to bottom direction
skinparam linetype polyline
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam ClassBackgroundColor white
skinparam ClassBorderColor #404040
skinparam ClassAttributeIconSize 0
skinparam ArrowColor #404040
skinparam RectangleBackgroundColor white
skinparam RectangleBorderColor #404040
skinparam PackageBackgroundColor #F7F7F7
skinparam PackageBorderColor #909090
skinparam LegendBackgroundColor white
skinparam LegendBorderColor #909090
skinparam nodesep 12
skinparam ranksep 34
hide circle
hide empty members

scale 700 width

class "Cubesat\n<<part def>>" as Cubesat #E8EEF7
class "**Bus**\n(bus)" as Bus {
}
class "**SolarPanel**\n(panelPlus, panelMinus)" as SolarPanel {
  <back:#9CC8EE><b> tune </b></back> panelSpan
}
class "**Battery**\n(battery)" as Battery {
  <back:#9CC8EE><b> tune </b></back> batteryCapacity
}
class "**Antenna**\n(antenna)" as Antenna {
}
class "**Imu**\n(imu)" as Imu {
}
class "**ReactionWheel**\n(wheel)\n<<abstract>>" as ReactionWheel {
  <back:#F6C98B><b> swap </b></back> WheelClass
}
class "**StarTracker**\n(tracker)\n<<abstract>>" as StarTracker {
  <back:#F6C98B><b> swap </b></back> TrackerGrade
}
class "**Controller**\n(controller)" as Controller {
  <back:#9CC8EE><b> tune </b></back> Kp
  <back:#9CC8EE><b> tune </b></back> Kd
}
Cubesat *-- Bus
Cubesat *-- SolarPanel
Cubesat *-- Battery
Cubesat *-- Antenna
Cubesat *-- Imu
Cubesat *-- ReactionWheel
Cubesat *-- StarTracker
Cubesat *-- Controller
class "**SmallWheel**" as SmallWheel {
}
class "**MediumWheel**" as MediumWheel {
}
class "**LargeWheel**" as LargeWheel {
}
class "**CoarseTracker**" as CoarseTracker {
}
class "**MediumTracker**" as MediumTracker {
}
class "**FineTracker**" as FineTracker {
}
ReactionWheel <|-- SmallWheel
ReactionWheel <|-- MediumWheel
ReactionWheel <|-- LargeWheel
StarTracker <|-- CoarseTracker
StarTracker <|-- MediumTracker
StarTracker <|-- FineTracker

legend bottom
  **Configuration variables** (each marked once, in the part it belongs to)
  <back:#F6C98B><b> swap </b></back> categorical: a part is swapped for one of its alternatives
  <back:#9CC8EE><b> tune </b></back> continuous: a parameter of a part is tuned within a range
  
  **Levels and ranges** (read from the model)
  WheelClass: small | medium | large
  TrackerGrade: coarse | medium | fine
  panelSpan: 0.3 m .. 1 m
  batteryCapacity: 20 W*h .. 200 W*h
  Gains Kp and Kd: one range per dataset (baseline, aggressive)
  Kp: 0.03 .. 1 (baseline gains); 0.2 .. 2 (aggressive gains)
  Kd: 0.3 .. 1.5 (both datasets)
end legend
@enduml
