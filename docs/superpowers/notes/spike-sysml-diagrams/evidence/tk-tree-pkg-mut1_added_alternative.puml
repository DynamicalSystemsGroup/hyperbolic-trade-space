  class "PowerRequirementHoldsInRange" as n86 <<constraint def>> {
    s : LengthValue
    t : PowerValue
    s >= 0.3 [m] and s <= 1.0 [m] and t >= 0.4 [W] and t <= 1.5 [W] implies 81.627336 [W / m] * s - 12.0 [W] - t > 0.0 [W]
  }
  class "SmallBatteryViolatesDepthOfDischarge" as n87 <<constraint def>> {
