@startuml
hide empty members
class "Cubesat" as n1 <<part def>> {
  panelSpan : LengthValue = 0.6 [m]
  batteryCapacity : EnergyValue = 80 [W*h]
  wheelCount : Integer = 3
  totalMass : MassValue
  structureMass : MassValue
  adcsMass : MassValue
  momentumCapacity : AngularMomentumValue = wheel.maxMomentum
  generatedPower : PowerValue
  availablePower : PowerValue
  usableWheelTorque : TorqueValue
}
class "bus : Bus" as n2 <<part>>
class "panelPlus : SolarPanel" as n3 <<part>> {
  span : LengthValue = 0.6 [m]
}
class "panelMinus : SolarPanel" as n4 <<part>> {
  span : LengthValue = 0.6 [m]
}
class "battery : Battery" as n5 <<part>> {
  capacity : EnergyValue = 80 [W*h]
}
class "antenna : Antenna" as n6 <<part>>
class "imu : Imu" as n7 <<part>>
class "wheel : ReactionWheel" as n8 <<part>>
class "tracker : StarTracker" as n9 <<part>>
class "controller : Controller" as n10 <<part>>
n1 *-- n2
n1 *-- n3
n1 *-- n4
n1 *-- n5
n1 *-- n6
n1 *-- n7
n1 *-- n8
n1 *-- n9
n1 *-- n10
@enduml
